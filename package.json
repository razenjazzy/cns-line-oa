{
  "name": "cns-line-oa",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "bin": {
    "cns": "dist/cli/index.js",
    "cns-mcp": "dist/mcp/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "cli": "node dist/cli/index.js",
    "mcp": "node dist/mcp/server.js",
    "worker": "node dist/worker.js",
    "preflight:staging": "bash ./scripts/preflight-check.sh staging deploy.env.staging.yaml",
    "preflight:prod": "bash ./scripts/preflight-check.sh production deploy.env.production.yaml",
    "cutover:check:staging": "bash ./scripts/validate-cutover.sh staging deploy.env.staging.yaml",
    "cutover:check:prod": "bash ./scripts/validate-cutover.sh production deploy.env.production.yaml",
    "deploy:validate:staging": "bash ./scripts/validate-deploy-env.sh staging deploy.env.staging.yaml",
    "deploy:validate:prod": "bash ./scripts/validate-deploy-env.sh production deploy.env.production.yaml",
    "deploy:staging": "bash ./deploy.sh staging",
    "deploy:prod": "bash ./deploy.sh production",
    "smoke": "bash ./scripts/smoke-check.sh",
    "evidence": "bash ./scripts/generate-deploy-evidence.sh",
    "cloudflare": "bash ./deploy-cloudflare.sh",
    "runner": "bash ./runner.sh",
    "runner:backend:build": "bash ./runner.sh backend:build",
    "runner:backend:test": "bash ./runner.sh backend:test",
    "runner:claw:check": "bash ./runner.sh claw:check",
    "runner:claw:run": "bash ./runner.sh claw:run",
    "runner:health": "bash ./runner.sh health",
    "runner:cloudrun": "bash ./runner.sh cloudrun",
    "runner:railway": "bash ./runner.sh railway",
    "railway:validate": "bash ./scripts/validate-railway.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:validators": "vitest run tests/command-validators.test.ts",
    "lint": "eslint src tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "@google-cloud/firestore": "^8.6.0",
    "@google/genai": "^2.10.0",
    "@line/bot-sdk": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bullmq": "^5.81.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.22.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.6.0",
    "pino": "^10.3.1",
    "redis": "^4.7.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@line/line-bot-mcp-server": "^0.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.8.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
