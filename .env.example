PORT=8080
NODE_ENV=production

# Optional: keep webhook-test private in production
ENABLE_WEBHOOK_TEST=false
WEBHOOK_TEST_TOKEN=
OPS_API_TOKEN=
MAX_JSON_BODY=64kb
USER_STATE_CACHE_MAX=10000
USER_STATE_CACHE_TTL_MS=3600000
READYZ_TIMEOUT_MS=2500
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_STORE=memory
RATE_LIMIT_REDIS_PREFIX=rl:
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_URL=

# LINE Credentials (default channel, used by POST /webhook)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Comma-separated LINE user IDs allowed to receive the admin role via ADMIN ENABLE.
# Required (and must include the requesting user) for ADMIN ENABLE to succeed at all.
ADMIN_USER_ID=
LINE_AGENT_NAME=Line Assistant

# Optional additional LINE OAs, received at POST /webhook/<channelId>.
# <ID> is the channelId uppercased (e.g. channelId "sales" -> LINE_CHANNEL_SALES_*).
# LINE_CHANNEL_<ID>_SECRET=
# LINE_CHANNEL_<ID>_ACCESS_TOKEN=
# Comma-separated service keys enabled for that channel (see src/services/service-catalog.ts).
# Omit to leave a channel unrestricted (all services enabled), matching default behavior.
# LINE_CHANNEL_<ID>_SERVICES=
# LINE_CHANNEL_DEFAULT_SERVICES=

# Odoo
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_RPC_TIMEOUT_MS=7000
ODOO_READ_RETRY_ATTEMPTS=3
ODOO_READ_RETRY_BASE_DELAY_MS=250
# Retries for idempotent writes only (update/delete); creates are never
# blindly retried — see src/services/odoo.ts reconciliation comments.
ODOO_WRITE_RETRY_ATTEMPTS=2

# Controlled rollout flags for Group-Buy
GROUPBUY_ENABLED=false
GROUPBUY_ROLLOUT_PERCENT=0
GROUPBUY_ALLOWED_USER_IDS=

# Odoo user verification (OTP + magic link)
PUBLIC_BASE_URL=http://localhost:8080
ODOO_VERIFY_OTP_TTL_MINUTES=10
# Max wrong OTP guesses before the verification challenge is invalidated
ODOO_VERIFY_OTP_MAX_ATTEMPTS=5
ODOO_VERIFY_DEBUG_INCLUDE_OTP=false

# Guided step-by-step forms (FORM USER CREATE, FORM SERVICE CREATE, FORM DEMO QUOTE)
GUIDED_FORM_TTL_MINUTES=10

# Pricing and cost-control model
AI_INPUT_COST_PER_1M_USD=0.35
AI_OUTPUT_COST_PER_1M_USD=1.25
LINE_MESSAGE_COST_USD=0.0012
ODOO_RPC_COST_USD=0.0008
FIRESTORE_READ_COST_USD=0.000002
FIRESTORE_WRITE_COST_USD=0.00001
INFRA_FIXED_MONTHLY_USD=120
SUPPORT_PER_CUSTOMER_MONTHLY_USD=18
PRICING_BASE_MARKUP_PERCENT=40
PRICING_ADVANCED_MARKUP_PERCENT=70
PRICING_ENTERPRISE_MARKUP_PERCENT=120
PRICING_RISK_BUFFER_PERCENT=12
PRICING_TARGET_MARGIN_PERCENT=65
PRICING_MONTHLY_BUDGET_CAP_USD=2500

# Demo panel production controls
ENABLE_DEMO_CONTROL_PANEL=false
DEMO_CONTROL_TOKEN=
DEMO_SESSION_SECRET=
DEMO_SESSION_TTL_MINUTES=30
DEMO_SESSION_ROTATE_GRACE_MINUTES=30
DEMO_SESSION_CONFIG_KEY=demoSessionSecretsV1
ALLOW_DEMO_HEADER_TOKEN_FALLBACK=false

# Optional AI / Google Cloud integrations
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_AI_STUDIO_API_KEY=
AI_OFF=false
# Only needed on a non-GCP host (e.g. a Railway test deploy), where
# Application Default Credentials aren't available automatically the way
# they are on Cloud Run. Paste a Firestore-capable service account's JSON
# key as a single-line string. Leave unset on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Attach your free Groq execution tier token
GROQ_API_KEY=

# Attach your free OpenRouter routing hub token
OPENROUTER_API_KEY=

# clawframework integration (optional) — routes free-form LINE chat through
# clawframework's call_llm (Groq/OpenRouter) instead of Gemini.
#   CLAWFRAMEWORK_ENABLED=true
#   CLAWFRAMEWORK_PROVIDER=groq|openrouter
#   CLAWFRAMEWORK_SEARCH=true|false
#   CLAWFRAMEWORK_PYTHON=/path/to/.venv/bin/python
CLAWFRAMEWORK_ENABLED=false
CLAWFRAMEWORK_PROVIDER=groq
CLAWFRAMEWORK_SEARCH=false
