# Copy to deploy.env.production.yaml and edit values.
NODE_ENV: "production"
ENABLE_WEBHOOK_TEST: "false"
# Keep disabled by default in production. The demo control panel shares this
# service's security surface (LINE/Odoo credentials) with a separate
# session/token auth system built for sales demos, not production admin use.
# Only set to "true" for a specific, time-boxed demo need, and prefer
# disabling it again afterward.
ENABLE_DEMO_CONTROL_PANEL: "false"
ALLOW_DEMO_HEADER_TOKEN_FALLBACK: "false"
MAX_JSON_BODY: "64kb"
READYZ_TIMEOUT_MS: "2500"
RATE_LIMIT_STORE: "redis"
RATE_LIMIT_REDIS_PREFIX: "rl:prod:"
GROUPBUY_ENABLED: "true"
GROUPBUY_ROLLOUT_PERCENT: "100"
PUBLIC_BASE_URL: "https://your-production-domain.example"
