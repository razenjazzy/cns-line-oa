# Optional Cloud Run-style yaml. Live VPS staging uses /opt/cns-line-oa/.env
# (see deploy.env.staging.example). Do not enable Redis/group-buy unless those exist.
NODE_ENV: "production"
ENABLE_WEBHOOK_TEST: "true"
ENABLE_DEMO_CONTROL_PANEL: "true"
ALLOW_DEMO_HEADER_TOKEN_FALLBACK: "false"
MAX_JSON_BODY: "64kb"
READYZ_TIMEOUT_MS: "2500"
RATE_LIMIT_STORE: "memory"
GROUPBUY_ENABLED: "false"
GROUPBUY_ROLLOUT_PERCENT: "0"
PUBLIC_BASE_URL: "https://amardhaka.io"
