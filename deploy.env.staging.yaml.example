# Copy to deploy.env.staging.yaml and edit values.
NODE_ENV: "production"
ENABLE_WEBHOOK_TEST: "true"
ENABLE_DEMO_CONTROL_PANEL: "true"
ALLOW_DEMO_HEADER_TOKEN_FALLBACK: "false"
MAX_JSON_BODY: "64kb"
READYZ_TIMEOUT_MS: "2500"
RATE_LIMIT_STORE: "redis"
RATE_LIMIT_REDIS_PREFIX: "rl:staging:"
GROUPBUY_ENABLED: "true"
GROUPBUY_ROLLOUT_PERCENT: "20"
PUBLIC_BASE_URL: "https://your-staging-domain.example"
