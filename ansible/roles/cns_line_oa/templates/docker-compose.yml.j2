services:
  app:
    image: {{ docker_image_name }}:{{ docker_image_tag }}
    build:
      context: .
      dockerfile: Dockerfile
    container_name: {{ app_name }}
    restart: unless-stopped
    env_file:
      - .env
    ports:
      - "127.0.0.1:{{ app_port }}:{{ app_port }}"
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "5"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:{{ app_port }}/healthz || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
