# Final delivery — separate LINE OA, Odoo, and tokens from staging.
# Demo and webhook-test stay off even if ENABLE_* is set.

APP_ENV=production
NODE_ENV=production
PORT=8080
ERP_PROVIDER=odoo

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_AGENT_NAME=
ADMIN_USER_ID=

GOOGLE_CLOUD_PROJECT=
# Omit GOOGLE_APPLICATION_CREDENTIALS_JSON on Cloud Run (use ADC)

ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

PUBLIC_BASE_URL=
OPS_API_TOKEN=

ENABLE_DEMO_CONTROL_PANEL=false
ENABLE_WEBHOOK_TEST=false
ENABLE_GRAPHQL=false
ENABLE_API_DOCS=false
LINE_WEBHOOK_ASYNC=false
CLAWFRAMEWORK_ENABLED=false
