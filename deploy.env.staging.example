LINE_CHANNEL_ID=
LINE_CHANNEL_BASIC_ID=
LINE_AGENT_NAME_EN=Sora
LINE_AGENT_NAME_TH=โซระ
LINE_RICH_MENU_EN=
LINE_RICH_MENU_TH=
LINE_RICH_MENU_JSON=
ADMIN_USER_ID=

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
