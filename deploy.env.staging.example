# Railway staging — copy keys into the Railway service. Do not commit real values.
# Image sets NODE_ENV=production. APP_ENV must be staging.

APP_ENV=staging
NODE_ENV=production
PORT=8080
ERP_PROVIDER=odoo

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_AGENT_NAME=
ADMIN_USER_ID=

GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

PUBLIC_BASE_URL=
OPS_API_TOKEN=
DEMO_CONTROL_TOKEN=
ENABLE_DEMO_CONTROL_PANEL=true
ENABLE_WEBHOOK_TEST=true
WEBHOOK_TEST_TOKEN=
ENABLE_GRAPHQL=true
ENABLE_API_DOCS=true

# Keep off on Railway unless Redis + worker exist
LINE_WEBHOOK_ASYNC=false
OPS_JOBS_ASYNC=false
RUN_BULLMQ_WORKER=false
MONGO_VECTOR_ENABLED=false
CLAWFRAMEWORK_ENABLED=false
