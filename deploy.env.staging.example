# Staging env for amardhaka.io. Lives on the server at /opt/cns-line-oa/.env
# Do not commit real values.

APP_ENV=staging
NODE_ENV=production
PORT=8080
ERP_PROVIDER=odoo
DEFAULT_LANGUAGE=en
PUBLIC_BASE_URL=https://amardhaka.io

LINE_CHANNEL_SECRET=
