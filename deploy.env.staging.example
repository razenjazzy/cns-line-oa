ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

OPS_API_TOKEN=
DEMO_CONTROL_TOKEN=
DEMO_SESSION_SECRET=
WEBHOOK_TEST_TOKEN=
ENABLE_DEMO_CONTROL_PANEL=true
ENABLE_WEBHOOK_TEST=true
ENABLE_GRAPHQL=true
ENABLE_API_DOCS=true
ALLOW_DEMO_HEADER_TOKEN_FALLBACK=false

RATE_LIMIT_STORE=memory
